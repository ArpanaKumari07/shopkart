# example .env file


# Port the Express API listens on (the Vite proxy expects 5000)
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopkart
MONGO_URI=

# Long random string used to sign login JWTs
JWT_SECRET=

# Razorpay TEST MODE keys 
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
